# Speech recognition in the cloud (Voxtral Mini Transcribe 3), which frees about 11 GB of GPU memory.
# The tutor and the voice stay local. Set CLOUD_LIVE_CAPTIONS=0 to save about two thirds of the hearing cost,
# at the price of seeing your words only when you release the button.
SHAHRAZAD_BRAIN=local
SHAHRAZAD_HEARING=cloud
SHAHRAZAD_VOICE=local
OPENROUTER_API_KEY=sk-or-your-key-here
