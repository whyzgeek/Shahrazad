# Everything in the cloud through one OpenRouter key: no GPU needed. About $0.35-0.70 per hour of practice.
# The tutor is the same Gemma 4 model as the local setup, so it behaves the same.
SHAHRAZAD_BRAIN=cloud
SHAHRAZAD_HEARING=cloud
SHAHRAZAD_VOICE=cloud
OPENROUTER_API_KEY=sk-or-your-key-here
# The voice. Other female voices: CLOUD_VOICE_NAME=eve, or
# CLOUD_VOICE_MODEL=google/gemini-3.8-flash-lite-tts with CLOUD_VOICE_NAME=Kore or Leda (slower, about 2 s a sentence).
CLOUD_VOICE_NAME=ara
