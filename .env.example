# OpenAI (Realtime voice + review TTS + LLM judge)
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_TRANSCRIPTION_LANGUAGE=ar
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=shimmer

# LiveKit Cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Tashkeel: Mishkal (local pip — no API key)
# Used for drill/review text TTS fallback only; not on the Realtime hot path.
TASHKEEL_TIMEOUT_MS=300

# SQLite (optional — defaults to shahrazad-agent/data/shahrazad.db)
DATABASE_URL=

# Guided session flow
FLOW_CONVERSATION_TURNS=6
# Legacy default when UI omits sentence_count (web sends 1–5 explicitly)
FLOW_MAX_REVIEW_DRILLS=3

# Practice drills
GRAMMAR_DRILL_SIMILAR_COUNT=2
GRAMMAR_DRILL_MAX_ATTEMPTS_PER_SENTENCE=3
DRILL_ACCURACY_THRESHOLD=80
DRILL_MAX_ATTEMPTS=5
DRILL_ENDPOINTING_MIN=0.7
DRILL_ENDPOINTING_MAX=1.0
CONVERSATION_ENDPOINTING_MIN=0.35
CONVERSATION_ENDPOINTING_MAX=0.9

# Optional (Phase 0 spikes only — not used by the live product)
# DEEPGRAM_API_KEY=
