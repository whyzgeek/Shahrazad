# Copy to .env and edit. .env is git-ignored.

# Required: a short, clear MSA recording of a voice you have the rights to use (WAV, about 6-10 s).
SHAHRAZAD_REF_AUDIO=

# Where scripts/download_models.sh puts the models.
SHAHRAZAD_MODELS=./models

# llama.cpp: a build recent enough for --spec-type draft-mtp.
LLAMA_SERVER=llama-server
# Only needed by scripts/convert_spark.sh.
LLAMA_CPP_DIR=

# Python environments, one per requirements file.
VENV_TUTOR=.venv-tutor
VENV_SPARK=.venv-spark
VENV_VOXTRAL=.venv-voxtral

# Which GPU runs what. Tested layout: two 12 GB cards.
GPU_LLM=0
GPU_ASR=1
# Gemma layers whose experts run on the CPU. Lower is faster but uses more GPU memory.
GEMMA_CPU_MOE=16
VOXTRAL_GPU_FRACTION=0.91

TUTOR_HOST=127.0.0.1
TUTOR_PORT=8791
