# Copy to .env and edit. .env is git-ignored.

# Where each part runs: local (on this computer's GPU) or cloud (through OpenRouter). See docs/CLOUD.md.
# install.sh tells you which parts to move to the cloud if your hardware can't run them.
SHAHRAZAD_BRAIN=local
SHAHRAZAD_HEARING=local
SHAHRAZAD_VOICE=local
# Needed only for parts set to cloud. Get one at https://openrouter.ai/keys, and add a few dollars of credit.
OPENROUTER_API_KEY=
# The cloud voice. Other female voices that read Arabic well: CLOUD_VOICE_NAME=eve, or
# CLOUD_VOICE_MODEL=google/gemini-3.8-flash-lite-tts with CLOUD_VOICE_NAME=Kore or Leda.
CLOUD_VOICE_NAME=ara
# Cloud hearing shows your words while you speak by re-transcribing as you go. 0 turns that off and cuts its cost by about two thirds.
CLOUD_LIVE_CAPTIONS=1

# The tutor's voice. The default is a CC0 clip from the ManaTTS dataset. To use another, give a clear 6-10 s WAV you have the right to use.
SHAHRAZAD_REF_AUDIO=assets/default_voice.wav

# Where install.sh puts the models.
SHAHRAZAD_MODELS=./models

# llama.cpp: a build recent enough for --spec-type draft-mtp.
LLAMA_SERVER=llama-server
# Only needed to convert Spark during install.
LLAMA_CPP_DIR=

# Python environments, one per requirements file.
VENV_TUTOR=.venv-tutor
VENV_SPARK=.venv-spark
VENV_VOXTRAL=.venv-voxtral

# Which GPU runs what. install.sh fills these in for your hardware.
GPU_LLM=0
GPU_ASR=1
GPU_VOICE=0
# Gemma layers whose experts run on the CPU. Lower is faster but uses more GPU memory.
GEMMA_CPU_MOE=16
VOXTRAL_GPU_FRACTION=0.91

# Use the server's LAN address to reach it from other devices, with HTTPS (./install.sh --lan).
# There is no login: anyone who can reach this address can use the tutor.
TUTOR_HOST=127.0.0.1
TUTOR_PORT=8791
TUTOR_SSL_CERT=
TUTOR_SSL_KEY=

# Where new messages and corrections appear: bottom (chat style) or top. Each browser can switch it with the button at the top right.
TUTOR_NEWEST=bottom

# Every process stops by itself after this many hours, and the tutor keeps both GPUs until then.
TUTOR_MAX_HOURS=8

# Set to 1 to save transcripts and replies to data/debug_transcripts.jsonl, for diagnosing problems.
TUTOR_DEBUG_LOG=
